receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:{{ observability_collector_grpc_port }}
      http:
        endpoint: 127.0.0.1:{{ observability_collector_http_port }}

processors:
  batch: {}

exporters:
  debug:
    verbosity: basic

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
